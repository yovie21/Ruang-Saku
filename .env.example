# Buat OAuth Client bertipe Web Application di Google Cloud Console.
# NEXTAUTH_URL harus URL dasar aplikasi, tanpa path /api/auth/callback/google.
# Daftarkan http://localhost:3000/api/auth/callback/google dan callback produksi di Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Pisahkan lebih dari satu email dengan koma.
ADMIN_EMAILS="admin@contoh.com"
VERCEL_SPEED_INSIGHTS_ID=""
